# ─── Banco de dados ───────────────────────────────────────────────────────────
# Substitua com a URL do banco PostgreSQL de produção
DATABASE_URL="postgresql://usuario:senha@localhost:5432/eixo_prod?schema=public"

# ─── Sessão ───────────────────────────────────────────────────────────────────
# Gere um salt único: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TOKEN_SALT="GERE_UM_SALT_ALEATORIO_DE_64_CHARS"
SESSION_TTL_MS="86400000"           # 24h — token de sessão padrão
SESSION_REMEMBER_TTL_MS="2592000000" # 30 dias — "lembrar de mim"

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN="https://eixo.ag"

# ─── Segurança ────────────────────────────────────────────────────────────────
ALLOW_X_USER_ID="false"   # NUNCA mudar para true em produção

# ─── Rate limiting OTP ────────────────────────────────────────────────────────
OTP_SEND_WINDOW_MS="600000"
OTP_SEND_MAX_PER_IP="5"
OTP_SEND_MAX_PER_PHONE="3"
OTP_VERIFY_WINDOW_MS="600000"
OTP_VERIFY_MAX_PER_IP="10"
OTP_VERIFY_MAX_PER_PHONE="5"

# ─── APIs externas ────────────────────────────────────────────────────────────
SUPPORT_AI_PROVIDER="groq"
SUPPORT_AI_FALLBACK_PROVIDER="gemini"
SUPPORT_MODEL_NAME="openai/gpt-oss-20b"
GROQ_API_KEY="SUA_CHAVE_GROQ_AQUI"
GOOGLE_API_KEY="SUA_GOOGLE_API_KEY"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
TWILIO_ACCOUNT_SID="SUA_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="SEU_TWILIO_AUTH_TOKEN"
TWILIO_VERIFY_SID="SEU_TWILIO_VERIFY_SID"
RESEND_API_KEY="SUA_RESEND_API_KEY"
RESEND_FROM_EMAIL="noreply@eixo.ag"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SUPPORT_ALERT_COOLDOWN_MS="900000"
SUPPORT_TELEGRAM_INCLUDE_MESSAGE="false"
SUPPORT_ROLLOUT_MODE="shadow"
# IDs separados por vírgula. Obrigatório quando SUPPORT_ROLLOUT_MODE="pilot".
SUPPORT_PILOT_ORGANIZATION_IDS=""

# ─── URLs ─────────────────────────────────────────────────────────────────────
APP_BASE_URL="https://eixo.ag"
APP_RELEASE_SHA="DEFINIDO_AUTOMATICAMENTE_NO_DEPLOY"
ADMIN_EMAIL="admin@eixo.ag"

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3001"
